{
	"name": "sv-forms",
	"version": "0.2.0",
	"description": "Thin Svelte components over SvelteKit remote form functions: <Form>, <Input> and <Select> wired to a form's fields, issues and result.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nachop51/sv-forms.git"
	},
	"homepage": "https://github.com/nachop51/sv-forms#readme",
	"bugs": "https://github.com/nachop51/sv-forms/issues",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright test",
		"pub": "bun run prepack && bun publish --ignore-scripts"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"dependencies": {
		"esm-env": "^1.2.2"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"publint": "^0.3.17",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.54.0",
		"valibot": "^1.3.1",
		"vite": "^8.0.12",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"forms",
		"remote-functions",
		"validation"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
